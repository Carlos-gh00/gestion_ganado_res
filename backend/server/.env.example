# ================================================================
# GanaderAPP - Variables de Entorno del Backend
# ================================================================

# Claves de Seguridad
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
JWT_SECRET_KEY=cambia-este-jwt-secret-en-produccion

# ================================================================
# CONFIGURACIÓN DE CORREO GMAIL (SMTP)
# ================================================================
# Para que el backend envíe el usuario y la contraseña por Gmail:
# 1. En tu cuenta de Google, activa la 'Verificación en 2 pasos'.
# 2. Entra a: https://myaccount.google.com/apppasswords
# 3. Genera una "Contraseña de aplicación" (nombre ej: GanaderAPP).
# 4. Copia la clave de 16 caracteres generada y pégala en MAIL_PASSWORD (sin espacios).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Tu cuenta de Gmail emisora
MAIL_USERNAME=tu_correo@gmail.com

# Tu contraseña de aplicación de 16 caracteres de Google
MAIL_PASSWORD=tu_contrasena_de_aplicacion

# Remitente visible en el correo
MAIL_DEFAULT_SENDER=GanaderAPP <tu_correo@gmail.com>

# URL de inicio de sesión de la aplicación web
APP_URL=http://localhost:5173
